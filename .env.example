# Copy this file to .env and uncomment/fill in the keys you need.
# docker compose auto-loads .env from this directory; docker-compose.yml
# passes these variables through to the container only when they are set.
# Anything left commented out is simply not passed in.

# === Claude Code (@anthropic-ai/claude-code) ===
# ANTHROPIC_API_KEY=sk-ant-...
# Optional, for bearer-token LLM gateways/proxies:
# ANTHROPIC_AUTH_TOKEN=
# Optional, to route through a custom/proxied API endpoint:
# ANTHROPIC_BASE_URL=

# === Codex (@openai/codex) ===
# OPENAI_API_KEY=sk-...
# Optional, API key for a single non-interactive `codex exec` run (CI):
# CODEX_API_KEY=
